{
  "name": "jandapress",
  "version": "10.2.0-alpha",
  "description": "Unified REST + GraphQL API for nhentai and other doujinshi.",
  "main": "build/src/index.js",
  "scripts": {
    "clean": "rm -rf build",
    "build": "bun run clean && bun build ./src/index.ts --outdir ./build/src --target=bun && bun build ./src/lib/openapi-spec.ts --outdir ./build/src/lib --target=bun",
    "start": "bun run src/index.ts",
    "start:prod": "bun run build/src/index.js",
    "start:dev": "bun run --watch src/index.ts",
    "lint": "bunx eslint . --ext .ts",
    "lint:fix": "bunx eslint . --fix",
    "test:scrape": "bun test ./test/test.ts",
    "test": "bun run test/nh.ts",
    "test:nhentai": "bun test test/jandapress.test.ts --test-name-pattern=^nhentai$",
    "test:hentaifox": "bun test test/jandapress.test.ts --test-name-pattern=^hentaifox$",
    "test:asmhentai": "bun test test/jandapress.test.ts --test-name-pattern=^asmhentai$",
    "test:hentai2read": "bun test test/jandapress.test.ts --test-name-pattern=^hentai2read$",
    "test:3hentai": "bun test test/jandapress.test.ts --test-name-pattern=^3hentai$",
    "test:rest:all": "bun run test:nhentai & bun run test:hentaifox & bun run test:asmhentai & bun run test:hentai2read & bun run test:3hentai & wait",
    "test:graphql:all": "bun test test/graphql.test.ts",
    "test:unit": "bun test test/unit-scrapers.test.ts"
  },
  "keywords": [],
  "author": "sinkaroid",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sinkaroid/jandapress.git"
  },
  "license": "MIT",
  "dependencies": {
    "@hono/prometheus": "^1.0.3",
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.6.1",
    "@keyv/redis": "^5.1.6",
    "cheerio": "^1.2.0",
    "got": "^15.1.0",
    "graphql": "^17.0.2",
    "hono": "^4.13.3",
    "keyv": "^5.6.0",
    "prom-client": "^15.1.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "packageManager": "bun@1.4.0"
}
